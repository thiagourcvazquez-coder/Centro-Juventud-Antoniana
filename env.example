# Copiar a .env.local y completar

# Supabase (mismo proyecto que el sitio estático)
NEXT_PUBLIC_SUPABASE_URL=https://rcusuuyakezwrwlpqiby.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role: solo servidor (API routes, webhook de MP). NUNCA exponer.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Mercado Pago — Access Token (producción o prueba)
# Es el mismo que hoy usa la Edge Function "crear-preferencia"
MP_ACCESS_TOKEN=APP_USR-...
# Secret de firma del webhook (opcional pero recomendado, se configura en
# "Tus integraciones" → Webhooks del panel de desarrolladores de MP)
MP_WEBHOOK_SECRET=

# URL pública del sitio (MP la usa para volver y para el webhook).
# En producción: https://tu-dominio.com
# En dev podés usar ngrok/similar si querés probar el webhook local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
